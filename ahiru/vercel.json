{
  "buildCommand": "npm run generate:sitemap && npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/lesson/:id", "destination": "/lesson/[id]" },
    { "source": "/quiz/:subject", "destination": "/quiz/[subject]" },
    { "source": "/topics/:subject", "destination": "/topics/[subject]" },
    { "source": "/school/:course", "destination": "/school/[course]" },
    { "source": "/eiken/:level", "destination": "/eiken/[level]" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
