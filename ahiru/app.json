{
  "expo": {
    "name": "Zaibase受験",
    "slug": "entrance-exam",
    "scheme": "entrance-exam",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zaibase.exam",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zaibase.exam",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "lang": "ja",
      "output": "static",
      "meta": {
        "description": "中学受験・高校受験対策アプリ。5科目13,000問以上・灘/開成/慶應など50校対応・図形やグラフが動く図解付き教科書。"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "問題の写真をAI先生に送るために写真へのアクセスが必要です。",
          "cameraPermission": "問題の写真を撮影してAI先生に質問するためにカメラへのアクセスが必要です。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fee2f912-842f-470e-a90a-5f885535db09"
      }
    }
  }
}
