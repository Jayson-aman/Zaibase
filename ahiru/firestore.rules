rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── AIコーチ利用回数カウンタ（Cloud Functions専用、クライアントから読み書き不可） ──
    match /aiCoachUsage/{uid} {
      allow read, write: if false;
    }

    // ── AI個別指導（Cloud Functions専用） ──
    match /aiTutorUsage/{uid} {
      allow read, write: if false;
    }

    match /aiTutorSessions/{docId} {
      allow read, write: if false;
    }

    // ── AI英会話練習の利用回数カウンタ（Cloud Functions専用） ──
    match /aiConversationUsage/{uid} {
      allow read, write: if false;
    }

    // ── 全国ランキング ──
    // 読み取りは本人の記録のみ。全体を読めるようにすると、誰でも全ユーザーの
    // ID・スコア・最終学習日時を一覧できてしまう（子ども向けアプリでは避ける）。
    // 順位の計算は Cloud Function（getMyRanking）が Admin 権限で行う。
    // 書き込みは本人の文書のみで、スコアの形式（0〜100、correct<=total）も
    // 検証してデタラメな値を弾く。
    match /examLeaderboard/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.pct is int
        && request.resource.data.pct >= 0
        && request.resource.data.pct <= 100
        && request.resource.data.correct is int
        && request.resource.data.total is int
        && request.resource.data.correct >= 0
        && request.resource.data.total > 0
        && request.resource.data.correct <= request.resource.data.total;
      // アカウント削除時に本人の登録を消せるようにする
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── 無料/Pro/MAXユーザーの課金対象モード・ペイウォール到達ログ ──
    // 「無料ユーザーが有料限定モードに何人到達したか」を後から数えられるように
    // するための集計専用ログ。書き込みは本人分のみ・作成のみ（追記式で編集不可）。
    // 他人の行動を推測されないよう、クライアントからの読み取りは一切許可しない
    // （集計はFirebase ConsoleかCloud Functionから行う）。
    match /accessEvents/{docId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.event is string
        && request.resource.data.mode is string
        && request.resource.data.tier in ['free', 'pro', 'max'];
    }

    // 上記以外は全て拒否（明示）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
