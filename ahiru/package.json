    "expo-audio": "~56.0.12",
    "expo-constants": "~56.0.20",
    "expo-font": "^56.0.7",
    "expo-image-picker": "~56.0.20",
    "expo-linear-gradient": "^56.0.4",
    "expo-linking": "~56.0.15",
    "expo-router": "^56.2.10",
    "expo-speech": "~56.0.3",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "56.0.3",
    "firebase": "^12.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-purchases": "9.15.3",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "^5.8.0",
