  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:history-images": "node scripts/generate-history-images.mjs",
    "generate:history-images:pro": "node scripts/generate-history-images.mjs --model pro",
    "gen:static": "npx --yes esbuild@0.23.1 scripts/gen-static-data.ts --bundle --platform=node --format=cjs --loader:.png=empty --loader:.jpg=empty --outfile=/tmp/gen-static.cjs --log-level=error && node /tmp/gen-static.cjs",
    "gen:static:check": "npx --yes esbuild@0.23.1 scripts/gen-static-data.ts --bundle --platform=node --format=cjs --loader:.png=empty --loader:.jpg=empty --outfile=/tmp/gen-static.cjs --log-level=error && node /tmp/gen-static.cjs --check",
    "gen:lessons": "npx --yes esbuild@0.23.1 scripts/gen-lessons.ts --bundle --platform=node --format=cjs --loader:.png=empty --loader:.jpg=empty --outfile=/tmp/gen-lessons.cjs --log-level=error && node /tmp/gen-lessons.cjs",
    "gen:lessons:check": "npx --yes esbuild@0.23.1 scripts/gen-lessons.ts --bundle --platform=node --format=cjs --loader:.png=empty --loader:.jpg=empty --outfile=/tmp/gen-lessons.cjs --log-level=error && node /tmp/gen-lessons.cjs --check",
    "gen:questions": "npx --yes esbuild@0.23.1 scripts/gen-questions.ts --bundle --platform=node --format=cjs --loader:.png=empty --loader:.jpg=empty --outfile=/tmp/gen-questions.cjs --log-level=error && node /tmp/gen-questions.cjs",
    "gen:questions:check": "npx --yes esbuild@0.23.1 scripts/gen-questions.ts --bundle --platform=node --format=cjs --loader:.png=empty --loader:.jpg=empty --outfile=/tmp/gen-questions.cjs --log-level=error && node /tmp/gen-questions.cjs --check",
    "audit": "bash scripts/audit.sh"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "^0.5.0"
  }
}
